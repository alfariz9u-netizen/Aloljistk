# Copy to .env and fill in real values. Never commit .env.
# This is the Russian-language build, localized for the Kyrgyzstan
# freight market (city list in backend/app/services/cities.py, all
# bot-facing text in Russian). Same architecture and security model as
# the base project -- only language/city localization differs.
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://freight:freight@postgres:5432/freightai
POSTGRES_USER=freight
POSTGRES_PASSWORD=freight
POSTGRES_DB=freightai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
# The numeric Telegram chat_id of the admin. This is the ONLY way admin
# access is granted server-side on first run (bootstraps the ADMIN role);
# after that, role lives in the database, not in this variable.
TELEGRAM_ADMIN_CHAT_ID=000000000

# --- Bot <-> Backend trust ---
# Shared secret ONLY known to the bot process and the backend. Proves an
# API request genuinely originated from our bot, not an arbitrary client.
# Generate with: openssl rand -hex 32
BOT_SERVICE_SECRET=change-me-to-a-long-random-value

BACKEND_BASE_URL=http://backend:8000

# --- AI extraction (optional; bot falls back to manual entry without it) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Rate limits (per user per window; tune freely) ---
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_LOADS_PER_HOUR=10
RATE_LIMIT_TRUCKS_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=15

# --- Matching ---
PROACTIVE_MATCH_WINDOW_MINUTES=60
REMINDER_DELAY_MINUTES=10

# =============================================================================
# Single-service free-hosting mode (Render/Fly/etc. + Supabase + Upstash).
# Leave these as-is / blank for the normal docker-compose (VPS) setup above --
# they only matter when deploying Dockerfile.webapp. See README.md's
# "Free hosting" section for the full walkthrough.
# =============================================================================

# "polling" (default, used by docker-compose.yml's separate `bot` + `worker`
# services) or "webhook" (single merged service, see Dockerfile.webapp).
BOT_MODE=polling

# Required when BOT_MODE=webhook: the public HTTPS URL your host gives this
# service, e.g. https://your-app.onrender.com (no trailing slash).
PUBLIC_BASE_URL=

# Required when BOT_MODE=webhook. Telegram echoes this back on every webhook
# call so /telegram/webhook can reject anything that isn't really from
# Telegram. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Required when BOT_MODE=webhook: guards POST /internal/cron/tick, which an
# external free pinger (e.g. cron-job.org) calls every few minutes to run the
# reminder + proactive-matching pass in place of a standalone worker process.
# A DIFFERENT secret than BOT_SERVICE_SECRET -- least privilege.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# In single-service mode, the bot talks to "itself" (same process, same
# port) instead of a separate `backend` container -- override
# BACKEND_BASE_URL above to:
#   BACKEND_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# Payments (Phase 2 monetization -- dormant by default). See README.md's
# payment section. Leave PAYMENTS_ENABLED=false for Phase 1 launch -- contact
# reveal stays free exactly like the base project until you're actually ready
# to charge for it.
# =============================================================================

# Master switch. false = free forever (Phase 1 default). true = the admin's
# "📞 Связаться" action requires a confirmed Payment before it reveals phone
# numbers (see backend/app/services/payments.py). Trusted pairs (repeat
# shipper+carrier relationships the admin already connected once) are always
# exempt, regardless of this setting.
PAYMENTS_ENABLED=false

# Who has to pay to unlock contact info for a match: "carrier" or "shipper".
PAYMENT_CHARGE_PARTY=carrier

# Fee in the currency's smallest unit -- tyiyn for KGS (100 tyiyn = 1 som).
# Example: 5000 = 50.00 KGS. Always an integer, never a float (avoids
# rounding-error bugs with money).
PAYMENT_CONTACT_FEE_AMOUNT=5000
PAYMENT_CURRENCY=KGS

# =============================================================================
# Premium auto-connect (dormant by default). See README.md's "Premium
# auto-connect" section for the trade-off before enabling: this skips the
# admin's fraud/quality screening for that carrier's matches, in exchange
# for speed.
# =============================================================================

# false = every match still goes through admin review (Phase 1 default,
# except already-TrustedPair matches, which always auto-connect). true = a
# match where the CARRIER is a paid subscriber or has >=1 referral also
# auto-connects immediately, with no admin step. Never applies to
# proactive/backhaul matches, regardless of this setting.
AUTO_CONNECT_PREMIUM_ENABLED=false
