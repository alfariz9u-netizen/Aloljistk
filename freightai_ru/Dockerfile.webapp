# Merged single-service image: bundles the FastAPI backend AND the
# Telegram bot (in webhook mode) into ONE process, for free/single-
# service hosting platforms that don't offer a free background-worker
# tier (see README.md's "Free hosting" section for the full deployment
# guide). Set BOT_MODE=webhook and the other webhook/cron env vars --
# see .env.example -- when running this image.
#
# For a VPS/always-on host (Oracle Cloud Always Free, a $5 VPS, etc.),
# prefer docker-compose.yml instead, which runs backend/bot/worker as
# separate containers with BOT_MODE=polling and a real standalone
# worker process -- that setup has no single-request-per-wakeup
# limitations and is the more "normal" production shape.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt backend-requirements.txt
COPY bot/requirements.txt bot-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt -r bot-requirements.txt

# Both `app` (backend) and `bot` land as top-level importable packages
# under /app, so `from bot.main import build_bot, ...` in app/main.py
# resolves correctly (see app/main.py's on_startup, BOT_MODE=webhook
# branch).
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY backend/alembic ./alembic
COPY backend/alembic.ini .
COPY bot/bot ./bot

ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
